<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (dataExtractionRules). Резервируем только лёгкие настройки,
     исключаем внутренние копии картинок (приватный/тяжёлый контент). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="slideshow/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="slideshow/" />
    </device-transfer>
</data-extraction-rules>
